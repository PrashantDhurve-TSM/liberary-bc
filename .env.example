NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/libraryhub
CORS_ORIGIN=http://localhost:5173

# Use two DIFFERENT long random strings (for example: openssl rand -hex 48)

JWT_ACCESS_SECRET=change-me-access-secret-test
JWT_REFRESH_SECRET=change-me-refresh-secret-test
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# strict when the UI and API share a site. Use none (and HTTPS) when they are on different sites.
COOKIE_SAMESITE=strict

# Creates the first admin on startup when no admin exists
ADMIN_EMAIL=admin@library.org
ADMIN_PASSWORD=ChangeMe123

# Librarian credentials on startup when no librarian exists
LIBRARIAN_EMAIL=librarian@library.org
LIBRARIAN_PASSWORD=ChangeMe123
